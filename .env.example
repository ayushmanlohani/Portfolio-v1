# Google Drive-backed Photography folder — see
# docs/superpowers/specs/2026-09-03-photography-drive-gallery-design.md

# The Drive folder's id, from https://drive.google.com/drive/folders/<this>
GDRIVE_PHOTOS_FOLDER_ID=

# A service account's client_email, shared as Viewer on that folder
GDRIVE_SA_EMAIL=

# That service account's private_key (PEM). Keep the \n escapes as downloaded.
GDRIVE_SA_PRIVATE_KEY=
